          <circle cx="480" cy="430" r="16" fill="#ff3159"/>
        </svg>
        <canvas id="orbCanvas" width="640" height="640" aria-label="Animated Aurora civic node network visual"></canvas>
        <div class="core-label">CIVIC NODE / DRONE / MESH</div>
      </div>
