<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content="Aurora Bridge by Aurora Logistical Eco Holdings - modular civic response infrastructure combining drone logistics, emergency mesh communications, rooftop-safe routes, public-service support and postal modernization." />
  <title>Aurora Bridge | Civil Response Infrastructure</title>
  <style>
    /*
      AURORA BRIDGE - CIVIC RESPONSE INFRASTRUCTURE LANDING PAGE
      ----------------------------------------------------------
      This file is designed to be dropped into GitHub Pages as index.html.
      It keeps your existing working structure, but reframes the page as an advert
      for the Aurora Logistical Eco Holdings concept, not just a control-nest demo.

      It remains a federated router:
      - The hamburger menu points to future external GitHub Pages service modules.
      - Missing pages may show 404 until each future repository is created.
      - Footer social icons are anchored in a fixed row, not floating around.

      EXPAND HERE:
      1. Change GitHub owner in JS: githubOwner
      2. Change future repo names in JS: navLinks
      3. Change social URLs in JS: socialLinks
      4. Copy this navigation/footer into future service pages.
    */

    :root {
      --bg: #030506;
      --panel: rgba(8,14,18,.78);
      --panel2: rgba(5,9,12,.96);
      --neon: #76ff7a;
      --yellow: #ffe95a;
      --red: #ff3159;
      --cyan: #37e7ff;
      --white: #ecfff3;
      --muted: rgba(236,255,243,.72);
      --line: rgba(118,255,122,.25);
      --shadow: 0 0 38px rgba(118,255,122,.14), 0 0 90px rgba(55,231,255,.07);
      --radius: 24px;
      --max: 1180px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      min-height: 100vh;
      color: var(--white);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      overflow-x: hidden;
      background:
        radial-gradient(circle at 12% 8%, rgba(118,255,122,.15), transparent 28%),
        radial-gradient(circle at 84% 10%, rgba(255,233,90,.11), transparent 26%),
        radial-gradient(circle at 50% 90%, rgba(255,49,89,.13), transparent 32%),
        linear-gradient(135deg, #020303 0%, #071015 48%, #030403 100%);
    }
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(rgba(255,255,255,.026) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.026) 1px, transparent 1px);
      background-size: 34px 34px;
      mask-image: radial-gradient(circle at center, black, transparent 82%);
      z-index: 0;
    }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; color: inherit; }

    .scanline {
      position: fixed;
      inset: 0;
      height: 18vh;
      pointer-events: none;
      z-index: 1;
      opacity: .26;
      background: linear-gradient(to bottom, transparent, rgba(118,255,122,.06), transparent);
      animation: scan 8s linear infinite;
    }
    @keyframes scan { from { transform: translateY(-25vh); } to { transform: translateY(120vh); } }
    @keyframes pulse { 50% { transform: scale(.94); opacity: .74; } }
    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes marquee { to { transform: translateX(-50%); } }
    @keyframes shimmer { from { transform: translateX(-120%); } to { transform: translateX(120%); } }

    .wrap { width: min(var(--max), calc(100% - 28px)); margin: 0 auto; position: relative; z-index: 2; }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      min-height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 12px clamp(14px, 3vw, 32px);
      border-bottom: 1px solid rgba(118,255,122,.2);
      background: rgba(3,5,7,.72);
      backdrop-filter: blur(18px) saturate(150%);
      transition: .25s ease;
    }
    .topbar.scrolled { background: rgba(3,5,7,.92); box-shadow: 0 14px 50px rgba(0,0,0,.45); }
    .brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .mark {
      width: 46px; height: 46px; flex: 0 0 auto;
      border-radius: 16px;
      border: 1px solid rgba(118,255,122,.42);
      background: radial-gradient(circle, rgba(118,255,122,.18), rgba(55,231,255,.08), transparent 70%);
      box-shadow: var(--shadow);
      position: relative; overflow: hidden;
    }
    .mark::before {
      content: ""; position: absolute; inset: 8px;
      border: 2px solid var(--neon); border-left-color: var(--yellow); border-bottom-color: var(--cyan);
      clip-path: polygon(50% 0,100% 88%,50% 68%,0 88%);
      filter: drop-shadow(0 0 8px rgba(118,255,122,.7));
      animation: pulse 2.8s ease-in-out infinite;
    }
    .brand h1 { font-size: clamp(17px, 4vw, 22px); line-height: 1; letter-spacing: .09em; }
    .brand small { display: block; margin-top: 5px; color: var(--muted); font-size: 11px; letter-spacing: .15em; text-transform: uppercase; }

    .hamburger {
      margin-left: auto; width: 54px; height: 48px;
      border: 1px solid rgba(118,255,122,.36);
      border-radius: 16px; background: rgba(8,14,18,.84);
      cursor: pointer; display: grid; place-items: center;
      box-shadow: 0 0 24px rgba(118,255,122,.08);
    }
    .hamburger:hover { border-color: rgba(255,233,90,.6); box-shadow: 0 0 26px rgba(255,233,90,.12); }
    .hamburger span,
    .hamburger span::before,
    .hamburger span::after {
      content: ""; width: 24px; height: 2px; display: block;
      border-radius: 99px; background: var(--neon); box-shadow: 0 0 10px var(--neon); transition: .25s ease;
    }
    .hamburger span::before { transform: translateY(-8px); }
    .hamburger span::after { transform: translateY(6px); }
    .hamburger.open span { background: transparent; box-shadow: none; }
    .hamburger.open span::before { transform: translateY(2px) rotate(45deg); }
    .hamburger.open span::after { transform: translateY(0) rotate(-45deg); }

    .menu {
      position: fixed; top: 82px; right: clamp(12px, 3vw, 30px); z-index: 60;
      width: min(92vw, 430px); max-height: calc(100vh - 96px); overflow: auto;
      padding: 14px; border-radius: 24px; border: 1px solid rgba(118,255,122,.28);
      background: linear-gradient(180deg, rgba(8,14,18,.97), rgba(5,8,11,.97));
      box-shadow: 0 22px 80px rgba(0,0,0,.65), var(--shadow);
      transform: translateX(120%) scale(.96); opacity: 0; pointer-events: none; transition: .28s ease;
    }
    .menu.open { transform: translateX(0) scale(1); opacity: 1; pointer-events: all; }
    .menu-title { color: var(--yellow); font-weight: 900; letter-spacing: .12em; text-transform: uppercase; font-size: 12px; margin: 8px 8px 12px; }
    .menu a {
      display: flex; justify-content: space-between; align-items: center; gap: 12px;
      padding: 14px; margin: 7px 0; border: 1px solid rgba(255,255,255,.09);
      border-radius: 16px; background: rgba(255,255,255,.035); transition: .2s ease;
    }
    .menu a:hover { border-color: rgba(118,255,122,.65); background: rgba(118,255,122,.08); transform: translateX(-4px); }
    .menu a small { color: var(--muted); display: block; margin-top: 4px; line-height: 1.35; }
    .pill { font-size: 10px; color: #071015; background: var(--neon); padding: 4px 7px; border-radius: 99px; font-weight: 1000; white-space: nowrap; }
    .pill.pending { background: var(--yellow); }

    .hero {
      min-height: calc(100vh - 72px);
      display: grid; grid-template-columns: 1.05fr .95fr;
      gap: clamp(24px, 5vw, 60px); align-items: center;
      padding: clamp(36px, 6vw, 76px) 0;
    }
    .eyebrow { color: var(--neon); font-weight: 1000; letter-spacing: .18em; text-transform: uppercase; font-size: 12px; }
    .hero h2 { font-size: clamp(42px, 8vw, 92px); line-height: .88; letter-spacing: -.065em; margin: 14px 0 18px; }
    .hero h2 span { color: var(--yellow); text-shadow: 0 0 24px rgba(255,233,90,.28); }
    .hero p { font-size: clamp(16px, 2.2vw, 21px); color: var(--muted); max-width: 760px; line-height: 1.65; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
    .btn {
      border: 1px solid rgba(118,255,122,.45);
      background: linear-gradient(135deg, rgba(118,255,122,.16), rgba(55,231,255,.06));
      padding: 14px 18px; border-radius: 16px; font-weight: 1000; cursor: pointer;
      box-shadow: 0 0 26px rgba(118,255,122,.1); transition: .2s ease;
      display: inline-flex; align-items: center; gap: 8px;
    }
    .btn:hover, .btn:focus-visible { transform: translateY(-3px); box-shadow: 0 0 38px rgba(118,255,122,.2); outline: none; }
    .btn.alt { border-color: rgba(255,233,90,.38); background: rgba(255,233,90,.08); }

    .hero-card {
      border: 1px solid rgba(118,255,122,.24); background: var(--panel);
      border-radius: 30px; padding: clamp(18px, 3vw, 30px); box-shadow: var(--shadow);
      position: relative; overflow: hidden; min-height: 460px; display: grid; place-items: center;
    }
    .hero-card::before {
      content: ""; position: absolute; inset: -2px;
      background: conic-gradient(from 180deg, transparent, rgba(118,255,122,.25), transparent, rgba(255,49,89,.18), transparent);
      animation: spin 12s linear infinite; opacity: .55;
    }
    .hero-card::after { content:""; position:absolute; inset:1px; border-radius:29px; background: rgba(5,8,11,.89); z-index:1; }
    .hero-card > * { position: relative; z-index: 2; }

    .node-visual { width: min(100%, 480px); aspect-ratio: 1; position: relative; }
    .node-visual canvas { width: 100%; height: 100%; display: block; position: absolute; inset: 0; z-index: 3; }
    .fallback-network { position:absolute; inset:0; z-index:2; filter: drop-shadow(0 0 18px rgba(118,255,122,.22)); }
    .core-label {
      position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%); z-index: 4;
      font-family: Consolas, monospace; font-size: 11px; color: var(--yellow); letter-spacing: .12em;
      text-align: center; background: rgba(0,0,0,.52); border: 1px solid rgba(255,233,90,.28);
      border-radius: 999px; padding: 8px 12px; white-space: nowrap;
    }

    .ticker { overflow: hidden; border-top: 1px solid rgba(118,255,122,.16); border-bottom: 1px solid rgba(118,255,122,.16); background: rgba(0,0,0,.22); padding: 12px 0; white-space: nowrap; }
    .ticker-track { display: flex; gap: 14px; animation: marquee 26s linear infinite; }
    .ticker span { color: var(--yellow); font-weight: 1000; letter-spacing: .08em; }

    main { padding: 42px 0; }
    .section-head { margin-bottom: 22px; }
    .section-head h3 { font-size: clamp(30px, 5vw, 56px); line-height: 1; margin-top: 8px; letter-spacing: -.045em; }
    .section-head p { color: var(--muted); line-height: 1.7; max-width: 860px; margin-top: 12px; }
    .grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 16px; }
    .card {
      grid-column: span 4; border: 1px solid rgba(118,255,122,.18);
      background: linear-gradient(180deg, rgba(12,19,24,.78), rgba(6,9,12,.84));
      border-radius: var(--radius); padding: 20px; box-shadow: 0 12px 40px rgba(0,0,0,.22);
      position: relative; overflow: hidden;
    }
    .card::before { content:""; position:absolute; inset:0; background: radial-gradient(circle at 8% 0%, rgba(118,255,122,.12), transparent 38%); pointer-events:none; }
    .card > * { position: relative; z-index: 1; }
    .card h4 { color: var(--yellow); font-size: 18px; margin-bottom: 10px; }
    .card p, .card li { color: var(--muted); line-height: 1.6; }
    .card ul { padding-left: 18px; }
    .wide { grid-column: span 8; }
    .full { grid-column: 1 / -1; }
    .half { grid-column: span 6; }
    .socket-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 18px; }
    .socket { display: flex; justify-content: space-between; gap: 12px; align-items: center; border: 1px solid rgba(255,233,90,.22); background: rgba(255,233,90,.055); border-radius: 18px; padding: 14px; transition: .2s ease; }
    .socket:hover { border-color: rgba(118,255,122,.55); background: rgba(118,255,122,.07); transform: translateY(-2px); }
    .socket b { display: block; color: var(--white); }
    .socket small { color: var(--muted); display:block; margin-top:4px; }

    .terminal { background: #020403; border: 1px solid rgba(118,255,122,.3); border-radius: 22px; overflow: hidden; box-shadow: inset 0 0 40px rgba(118,255,122,.05), var(--shadow); }
    .term-top { display:flex; gap:8px; align-items:center; padding:12px 14px; border-bottom:1px solid rgba(118,255,122,.18); background: rgba(255,255,255,.035); }
    .dot { width:10px; height:10px; border-radius:50%; background: var(--red); box-shadow:0 0 10px var(--red); }
    .dot:nth-child(2){ background:var(--yellow); box-shadow:0 0 10px var(--yellow); }
    .dot:nth-child(3){ background:var(--neon); box-shadow:0 0 10px var(--neon); }
    .term-screen { min-height: 255px; padding: 18px; font-family: Consolas, monospace; color: var(--neon); font-size: 13px; line-height: 1.6; white-space: pre-wrap; }
    .audit-note { border-left: 4px solid var(--neon); padding: 16px 18px; background: rgba(118,255,122,.06); border-radius: 0 18px 18px 0; color: var(--muted); line-height:1.7; }

    footer { position: relative; z-index: 2; border-top: 1px solid rgba(118,255,122,.2); background: linear-gradient(180deg, rgba(3,5,7,.78), rgba(0,0,0,.94)); padding: 22px 0 20px; }
    .footer-grid { display:grid; grid-template-columns: 1.2fr auto 1fr; gap:18px; align-items:center; }
    .foot-brand h3 { font-size: 20px; letter-spacing:.12em; }
    .foot-brand p, .foot-mini { color:var(--muted); font-size:12px; line-height:1.5; margin-top:6px; }

    /* Footer links are now anchored in a stable row. No orbit/floating movement. */
    .social-orbit {
      width: auto;
      min-width: 288px;
      height: auto;
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border: 1px solid rgba(118,255,122,.18);
      border-radius: 999px;
      background: rgba(255,255,255,.035);
      box-shadow: inset 0 0 20px rgba(118,255,122,.035);
      perspective: none;
    }
    .orbit-ring { display: none; }
    .bubble {
      position: relative;
      top: auto; left: auto;
      width: 42px; height: 42px; margin: 0;
      border-radius: 50%; display:grid; place-items:center;
      background: radial-gradient(circle at 30% 25%, rgba(255,255,255,.24), rgba(55,231,255,.12), rgba(0,0,0,.78));
      border:1px solid rgba(118,255,122,.28);
      box-shadow:0 0 18px rgba(55,231,255,.12);
      transform: none;
      transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease, background .18s ease;
      animation: none;
    }
    .bubble:hover, .bubble:focus-visible {
      transform: scale(1.12);
      border-color:var(--yellow);
      box-shadow:0 0 26px rgba(255,233,90,.24), 0 0 14px rgba(118,255,122,.18);
      outline: none;
    }
    .bubble:active { transform: scale(.94); }
    .bubble svg { width: 21px; height: 21px; fill: var(--white); filter: drop-shadow(0 0 6px rgba(118,255,122,.45)); }
    .status-pill { display:inline-flex; align-items:center; gap:8px; padding:9px 12px; border:1px solid rgba(118,255,122,.24); border-radius:999px; color:var(--neon); font-size:12px; font-weight:900; }
    .status-pill i { width:8px; height:8px; border-radius:50%; background:var(--neon); box-shadow:0 0 12px var(--neon); }

    @media (max-width: 900px) {
      .hero { grid-template-columns: 1fr; min-height: auto; }
      .hero-card { order: -1; min-height: 360px; }
      .grid, .socket-grid { grid-template-columns: 1fr; }
      .card, .wide, .half, .full { grid-column: 1; }
      .footer-grid { grid-template-columns: 1fr; text-align:center; }
      .social-orbit { margin:0 auto; min-width: 0; width: min(100%, 330px); flex-wrap: wrap; border-radius: 24px; }
      .footer-grid > div:last-child { text-align:center !important; }
    }
    @media (max-width: 560px) {
      .brand small { display:none; }
      .hero h2 { font-size: 43px; }
      .hero-card { min-height: 330px; }
      .term-screen { font-size: 12px; }
      .bubble { width:40px; height:40px; }
      .bubble svg { width: 19px; height: 19px; }
      .core-label { font-size: 9px; }
    }
  </style>
</head>
<body>
  <div class="scanline"></div>

  <header class="topbar" id="topbar">
    <a class="brand" href="./index.html" aria-label="Aurora Bridge home">
      <div class="mark" aria-hidden="true"></div>
      <div>
        <h1>AURORA BRIDGE</h1>
