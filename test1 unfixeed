      function initOrb() {
        var canvas = qs("#orbCanvas");
        if (!canvas || !canvas.getContext) { return; }
        var ctx = canvas.getContext("2d");
        var nodes = [];
        for (var i = 0; i < 62; i += 1) {
          nodes.push({ x: Math.random(), y: Math.random(), z: Math.random(), vx: (Math.random() - 0.5) * 0.002, vy: (Math.random() - 0.5) * 0.002 });
        }
        function draw() {
          var w = canvas.width, h = canvas.height;
          var t = Date.now() * 0.001;
          var cx = w / 2, cy = h / 2, r = w * 0.38;
          ctx.clearRect(0, 0, w, h);
          ctx.save();
          ctx.translate(cx, cy);
          ctx.rotate(t * 0.08);
          ctx.strokeStyle = "rgba(118,255,122,.22)";
          ctx.lineWidth = 2;
          for (var ring = 0; ring < 5; ring += 1) { ctx.beginPath(); ctx.arc(0, 0, r * (0.24 + ring * 0.16), 0, Math.PI * 2); ctx.stroke(); }
          ctx.restore();
          var pts = [];
          nodes.forEach(function (n) {
            n.x += n.vx; n.y += n.vy;
            if (n.x < 0 || n.x > 1) { n.vx *= -1; }
            if (n.y < 0 || n.y > 1) { n.vy *= -1; }
            var angle = (n.x * Math.PI * 2) + t * 0.12;
            var rad = r * (0.2 + n.y * 0.78);
            pts.push({ x: cx + Math.cos(angle) * rad, y: cy + Math.sin(angle) * rad * 0.74, z: n.z });
          });
          for (var a = 0; a < pts.length; a += 1) {
            for (var b = a + 1; b < pts.length; b += 1) {
              var dx = pts[a].x - pts[b].x, dy = pts[a].y - pts[b].y, d = Math.sqrt(dx * dx + dy * dy);
              if (d < 110) { ctx.strokeStyle = "rgba(55,231,255," + ((1 - d / 110) * 0.36) + ")"; ctx.beginPath(); ctx.moveTo(pts[a].x, pts[a].y); ctx.lineTo(pts[b].x, pts[b].y); ctx.stroke(); }
            }
          }
          pts.forEach(function (p, idx) { ctx.beginPath(); ctx.fillStyle = idx % 7 === 0 ? "rgba(255,233,90,.95)" : "rgba(118,255,122,.9)"; ctx.arc(p.x, p.y, 3 + p.z * 3, 0, Math.PI * 2); ctx.fill(); });
