    <button class="hamburger" id="hamburger" aria-label="Open navigation menu" aria-expanded="false" type="button"><span></span></button>
  </header>

  <nav class="menu" id="menu" aria-label="Aurora Bridge navigation menu">
    <div class="menu-title">Aurora Service Modules</div>
    <div id="menuItems">
      <a href="./index.html"><span><b>Aurora Bridge Home</b><small>Civil response infrastructure landing page.</small></span><span class="pill">LIVE</span></a>
      <a href="https://aol83.github.io/aurora-bridge-civic-response/"><span><b>Civic Response Upgrade</b><small>Future service page. May 404 until built.</small></span><span class="pill pending">SOCKET</span></a>
      <a href="https://aol83.github.io/aurora-bridge-drone-towers/"><span><b>Drone Tower Infrastructure</b><small>Future service page. May 404 until built.</small></span><span class="pill pending">SOCKET</span></a>
    </div>
  </nav>

  <section class="wrap hero">
    <div>
      <div class="eyebrow">Aurora Logistical Eco Holdings</div>
      <h2>Connect. <span>Deliver.</span> Protect.</h2>
      <p>
        Aurora Bridge is a modular civil-response infrastructure concept: drone-ready towers, rooftop-safe routes,
        emergency mesh communications, public-service telemetry, rapid kit delivery and postal logistics modernization
        built around one federated control nest.
      </p>
      <div class="hero-actions">
        <a class="btn" href="#civic-mission">Civil Service Upgrade</a>
        <a class="btn alt" href="#infrastructure">Drone Tower Network</a>
        <a class="btn" href="#page-sockets">Open Service Modules</a>
      </div>
    </div>

    <div class="hero-card">
      <div class="node-visual">
        <svg class="fallback-network" viewBox="0 0 600 600" aria-hidden="true">
          <defs>
            <radialGradient id="coreGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#ecfff3" stop-opacity="1"/>
              <stop offset="35%" stop-color="#76ff7a" stop-opacity=".8"/>
              <stop offset="100%" stop-color="#76ff7a" stop-opacity="0"/>
            </radialGradient>
          </defs>
          <circle cx="300" cy="300" r="230" fill="none" stroke="rgba(118,255,122,.18)" stroke-width="2"/>
          <circle cx="300" cy="300" r="175" fill="none" stroke="rgba(55,231,255,.16)" stroke-width="2"/>
          <circle cx="300" cy="300" r="120" fill="none" stroke="rgba(255,233,90,.15)" stroke-width="2"/>
          <line x1="300" y1="300" x2="120" y2="180" stroke="rgba(118,255,122,.55)" stroke-width="2"/>
          <line x1="300" y1="300" x2="480" y2="180" stroke="rgba(118,255,122,.55)" stroke-width="2"/>
          <line x1="300" y1="300" x2="120" y2="430" stroke="rgba(55,231,255,.45)" stroke-width="2"/>
          <line x1="300" y1="300" x2="480" y2="430" stroke="rgba(55,231,255,.45)" stroke-width="2"/>
          <line x1="120" y1="180" x2="480" y2="180" stroke="rgba(255,233,90,.3)" stroke-width="2" stroke-dasharray="8 9"/>
          <line x1="120" y1="430" x2="480" y2="430" stroke="rgba(255,233,90,.3)" stroke-width="2" stroke-dasharray="8 9"/>
